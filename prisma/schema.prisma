generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  PARTNER
}

enum FinanceRecordType {
  INCOME
  EXPENSE
  SAVING_ALLOCATION
  INVESTMENT_BUY
  INVESTMENT_SELL
}

enum InvestmentAssetType {
  GOLD
  STOCK_ID
  CRYPTO
  MUTUAL_FUND
  BOND
  MONEY_MARKET
}

enum PeriodFlow {
  SPOTTING
  LIGHT
  MEDIUM
  HEAVY
}

enum ReadingStatus {
  WANT_TO_READ
  READING
  FINISHED
  PAUSED
}

enum ReadingCategory {
  FINANCIAL_LITERACY
  SEXUAL_REPRODUCTIVE_HEALTH
  LAW
  SELF_DEVELOPMENT
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  name           String?
  image          String?
  passwordHash   String?
  emailVerified  DateTime?
  coupleId       String?
  role           UserRole        @default(PARTNER)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  couple         Couple?         @relation(fields: [coupleId], references: [id], onDelete: SetNull)
  accounts       Account[]
  sessions       Session[]
  financeRecords FinanceRecord[]
  investments    InvestmentPortfolio[]
  periodLogs     PeriodLog[]
  readingItems   ReadingListItem[]
  notifications  PartnerNotification[]

  @@index([coupleId])
}

model Couple {
  id             String          @id @default(cuid())
  displayName    String
  inviteCodeHash String?         @unique
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  users          User[]
  financeRecords FinanceRecord[]
  goals          SavingsGoal[]
  investments    InvestmentPortfolio[]
  periodLogs     PeriodLog[]
  readingItems   ReadingListItem[]
  notifications  PartnerNotification[]
}

model FinanceRecord {
  id          String            @id @default(cuid())
  coupleId    String
  userId      String
  type        FinanceRecordType
  category    String
  amount      Decimal           @db.Decimal(18, 2)
  currency    String            @default("IDR")
  occurredAt  DateTime
  note        String?
  goalId      String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  couple      Couple            @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  user        User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  goal        SavingsGoal?      @relation(fields: [goalId], references: [id], onDelete: SetNull)

  @@index([coupleId, occurredAt])
  @@index([coupleId, type])
}

model SavingsGoal {
  id             String          @id @default(cuid())
  coupleId       String
  name           String
  targetAmount   Decimal         @db.Decimal(18, 2)
  currentAmount  Decimal         @default(0) @db.Decimal(18, 2)
  targetDate     DateTime?
  color          String          @default("#98FF98")
  isArchived     Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  couple         Couple          @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  records        FinanceRecord[]

  @@index([coupleId, isArchived])
}

model InvestmentPortfolio {
  id             String              @id @default(cuid())
  coupleId       String
  userId         String
  assetType      InvestmentAssetType
  symbol         String
  name           String
  quantity       Decimal             @db.Decimal(24, 8)
  averagePrice   Decimal             @db.Decimal(18, 2)
  currency       String              @default("IDR")
  provider       String?
  externalId     String?
  lastPrice      Decimal?            @db.Decimal(18, 2)
  lastPriceAt    DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  couple         Couple              @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  user           User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  priceSnapshots InvestmentPriceSnapshot[]

  @@unique([coupleId, assetType, symbol])
  @@index([coupleId, assetType])
}

model InvestmentPriceSnapshot {
  id           String              @id @default(cuid())
  portfolioId  String
  assetType    InvestmentAssetType
  symbol       String
  price        Decimal             @db.Decimal(18, 2)
  currency     String              @default("IDR")
  source       String
  capturedAt   DateTime            @default(now())
  portfolio    InvestmentPortfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([symbol, capturedAt])
}

model PeriodLog {
  id              String      @id @default(cuid())
  coupleId        String
  userId          String
  date            DateTime
  flow            PeriodFlow?
  symptoms        String[]    @default([])
  mood            String?
  temperatureC    Decimal?    @db.Decimal(4, 2)
  notes           String?
  cycleLengthDays Int?
  periodLengthDays Int?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  couple          Couple      @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  user            User        @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, date])
  @@index([coupleId, date])
}

model ReadingListItem {
  id          String          @id @default(cuid())
  coupleId    String
  userId      String
  title       String
  author      String?
  category    ReadingCategory
  status      ReadingStatus   @default(WANT_TO_READ)
  rating      Int?
  startedAt   DateTime?
  finishedAt  DateTime?
  notes       String?
  coverUrl    String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  couple      Couple          @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  user        User            @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([coupleId, category])
  @@index([coupleId, status])
}

model PartnerNotification {
  id          String    @id @default(cuid())
  coupleId    String
  userId      String
  title       String
  body        String
  type        String
  scheduledAt DateTime
  sentAt      DateTime?
  readAt      DateTime?
  metadata    Json?
  createdAt   DateTime  @default(now())
  couple      Couple    @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, scheduledAt])
  @@index([coupleId, type])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
